{
  "name": "@solcreek/adapter-core",
  "version": "0.1.0",
  "description": "Portable Next.js adapter utilities shared by @solcreek/adapter-creek (CF Workers) and @solcreek/adapter-creekd (creekd self-host)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache-handler": {
      "default": "./dist/cache-handler.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "creek",
    "nextjs",
    "adapter",
    "deployment"
  ],
  "author": "SolCreek",
  "license": "Apache-2.0",
  "homepage": "https://creek.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/solcreek/adapter-core.git"
  },
  "peerDependencies": {
    "next": ">=16.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "next": "16.2.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.33.0"
}
